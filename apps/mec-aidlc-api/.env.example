# Copia a .env y rellena. NUNCA subas .env al repo (ADR-0005).

# --- Notion (ADR-0002) ---
NOTION_TOKEN=secret_xxx_tu_token_de_integracion
NOTION_DATA_SOURCE_ID=089a8a3d-02f4-4aa6-bad5-1d3c53728e32
# BD 'Equipo de Desarrollo — Fichas' para validar el evaluado (ADR-0007). Vacío = sin validación.
NOTION_FICHAS_DATA_SOURCE_ID=
NOTION_EVALUADO_PROPERTY=Evaluado
NOTION_VERSION=2022-06-28
NOTION_TIMEOUT_S=10

# --- Auth OAuth2 + JWT: Auth0 (ADR-0003) ---
# iss = dominio del tenant (con barra final); aud = API identifier configurado en Auth0.
JWT_ISSUER=https://tu-tenant.us.auth0.com/
JWT_AUDIENCE=https://mec-aidlc-api
JWT_JWKS_URL=https://tu-tenant.us.auth0.com/.well-known/jwks.json
JWT_ALGORITHMS=RS256
# Claim de roles (Auth0 requiere namespace; lo añade una Action). Vacío si usas 'permissions' (RBAC).
JWT_ROLES_CLAIM=https://mec-aidlc/roles
# Solo desarrollo local (HS256). Dejar vacío en prod.
JWT_DEV_SHARED_SECRET=
# Solo desarrollo local. NUNCA true en prod.
AUTH_DISABLED=false
